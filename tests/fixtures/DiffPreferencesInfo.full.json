{
  "auto_hide_diff_table_header": true,
  "context": 10,
  "cursor_blink_rate": 1,
  "expand_all_comments": true,
  "font_size": 1,
  "hide_empty_pane": true,
  "hide_line_numbers": true,
  "hide_top_menu": true,
  "ignore_whitespace": "IGNORE_TRAILING",
  "intraline_difference": true,
  "line_length": 100,
  "line_wrapping": true,
  "manual_review": true,
  "match_brackets": true,
  "render_entire_file": true,
  "responsive_mode": "SHRINK_ONLY",
  "retain_header": true,
  "show_line_endings": true,
  "show_tabs": true,
  "show_whitespace_errors": true,
  "skip_deleted": true,
  "skip_unchanged": true,
  "skip_uncommented": true,
  "syntax_highlighting": true,
  "tab_size": 8
}
